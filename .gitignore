# ===============================================================
# 1. DATOS GEOESPACIALES Y AMBIENTALES (ARCHIVOS PESADOS/BINARIOS)
# ===============================================================
# Rásteres pesados e imágenes satelitales
*.tif
*.tiff
*.geotiff
*.jp2
*.img
*.nc
*.hdf
*.hdf5

# Nubes de puntos y elevación
*.las
*.laz
*.dem

# Tablas pesadas o bases de datos espaciales locales
*.gpkg
*.sqlite
*.mdf
*.ldf

# Archivos auxiliares, índices y pirámides de GDAL/QGIS/ArcGIS
*.aux.xml
*.ovr
*.tfw
*.xml
*.prj.xml
*.cpg

# Archivos de bloqueo (Lockfiles) de software SIG
*.qgz~
*.qgs~
*.lock
*.sr.lock
*.edited.*

# ===============================================================
# 2. ESTRUCTURA DE DIRECTORIOS DEL PROYECTO (DATA PIPELINE)
# ===============================================================
# Ignorar datos crudos e intermedios no versionables
data/raw/
data/interim/
data/cache/

# Permitir explícitamente tablas CSV procesadas para GitHub
!data/processed/
!data/processed/*.csv

# ===============================================================
# 3. ENTORNO PYTHON, PAQUETES Y COMPILADOS
# ===============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# C extensions
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Entornos Virtuales)
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Package managers / Lock files de dependencias pesadas
.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml
__pypackages__/

# Unit test / coverage reports / Type checkers
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
