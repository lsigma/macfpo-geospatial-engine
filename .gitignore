*.ovr
*.tfw
*.xml
*.prj.xml
*.cpg
*.qml

# Archivos de bloqueo (Lockfiles) de software SIG
*.qgz~
*.qgs~
*.lock
*.sr.lock
*.edited.*

# ===============================================================
# 2. ESTRUCTURA DE DIRECTORIOS DEL PROYECTO (DATA PIPELINE)
